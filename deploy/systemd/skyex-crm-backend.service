[Unit]
Description=SkyEx CRM Telegram bot and API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/CRM
EnvironmentFile=/etc/skyex/crm-backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/CRM/.venv/bin/python /root/CRM/main.py
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target

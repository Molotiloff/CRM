[Unit]
Description=SkyEx CRM frontend
After=network.target skyex-bot.service
Wants=skyex-bot.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/skyex-crm-front
EnvironmentFile=-/etc/skyex/crm-front.env
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

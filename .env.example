# Обязательные настройки
BOT_TOKEN=replace-with-telegram-bot-token
DATABASE_URL=postgresql://bot:replace-password@127.0.0.1:5432/botdb

# Telegram: административные и операционные чаты
ADMIN_CHAT_ID=0
ADMIN_IDS=
REQUEST_CHAT_ID=
CASH_CHAT_ID=
CITY_SCHEDULE_CHATS=
SCHEDULE_CHAT_IDS=
RATE_ORDERS_CHAT_ID=
BEST_CHANGE_CHAT_ID=
DEFAULT_CITY=екб

# Город -> чат физической кассы, например: екб:-1001,члб:-1002,тюм:-1003
CITY_CASH_CHAT_IDS=

# Будущие гибридные чаты: RUB учитывается как касса, остальные валюты — как клиентские
MOSCOW_POETS_CHAT_ID=
MOSCOW_BS_CHAT_ID=

# Google Sheets. Достаточно GOOGLE_SHEET_URL или GOOGLE_SHEET_ID.
GOOGLE_SHEET_URL=
GOOGLE_SHEET_ID=

# Укажите один способ передачи service account: inline JSON либо путь к файлу.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_FILE=

# Конвертер валют
CONVERTER_API_BASE_URL=
CONVERTER_API_TOKEN=

# Отслеживание USDT-платежей
TRONSCAN_API_BASE_URL=
TRONSCAN_API_KEY=
TRONSCAN_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
PAYMENT_WATCH_POLL_INTERVAL_SECONDS=30
PAYMENT_WATCH_TIMEOUT_SECONDS=900

# GetBlock AML. Интеграция включается, когда заданы IDENTITY и PASSWORD.
GETBLOCK_IDENTITY=
GETBLOCK_PASSWORD=
GETBLOCK_LANG=en
GETBLOCK_USER_ID=
GETBLOCK_CURRENCY_CODE=TRX
GETBLOCK_TOKEN_ID=9
GETBLOCK_AML_PROVIDER=2
GETBLOCK_DIRECTION=2
GETBLOCK_SOURCE=1
GETBLOCK_TYPE=0
GETBLOCK_REPORTS_DIR=reports

# CRM API
CRM_API_ENABLED=true
CRM_API_HOST=127.0.0.1
CRM_API_PORT=8000
CRM_API_CORS_ORIGINS=
CRM_API_JWT_TTL_SECONDS=604800

# Только для локальной разработки. Bypass разрешён лишь на loopback-хосте.
CRM_DEV_AUTH_BYPASS=false
CRM_DEV_TG_USER_ID=

# Источник главной: sheets, db_shadow, db_primary или db_only
MAIN_DASHBOARD_SOURCE_MODE=sheets
DASHBOARD_SHADOW_ABSOLUTE_TOLERANCE=0.01
DASHBOARD_SHADOW_RELATIVE_TOLERANCE=0.000001

# Архив сообщений Telegram
MESSAGE_ARCHIVE_ENABLED=false
MESSAGE_ARCHIVE_MEDIA_DIR=message_archive_data/media
MESSAGE_ARCHIVE_TEMP_DIR=message_archive_data/tmp
MESSAGE_ARCHIVE_DOWNLOAD_WORKERS=2
MESSAGE_ARCHIVE_DOWNLOAD_QUEUE_SIZE=500
MESSAGE_ARCHIVE_EXPORT_WORKERS=1
MESSAGE_ARCHIVE_EXPORT_PART_BYTES=47185920
